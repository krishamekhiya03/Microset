<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <isExposed>true</isExposed>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordAction</target>
    </targets>
    <targetConfigs>
        <!--
            lightning__RecordPage  : recordId injected automatically by platform.
            lightning__RecordAction: recordId injected automatically (Quick Action).
            No manual property needed for RecordAction targets.
        -->
        <targetConfig targets="lightning__RecordPage">
            <property name="recordId" type="String" label="Quotation Record Id"
                description="Platform provides this automatically on a record page." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>