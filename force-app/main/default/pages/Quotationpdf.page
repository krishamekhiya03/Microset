<apex:page controller="QuotationPDFController"
           renderAs="pdf"
           showHeader="false"
           sidebar="false"
           standardStylesheets="false"
           applyBodyTag="false"
           applyHtmlTag="false"
           cache="false">
    
    <html>
        <head>
            <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
            <style>
                @font-face {
                font-family: 'NotoSansFont';
               src: url('{!URLFOR($Resource.NotoSansFont)}')format('truetype');
               font-weight: normal;
               font-style: normal;
                }
                
                /* =========================================
                MULTIPLE LINE ITEM IMAGES
                ========================================= */
                
                .images-container{
                margin-top:8px;
                width:100%;
                
                overflow:hidden;
                }
                
                .line-image-box{
                
                width:100%;
                
                overflow:hidden;
                
                margin-top:6px;
                }
                
                .line-image{
                
                width:95%;
                max-width:320px;
                
                height:auto;
                
                border:1px solid #ccc;
                
                padding:2px;
                
                background:#fff;
                
                display:block;
                }
                
                /* ===== PAGE ===== */
                @page {
                size: A4;
                margin: 100px 25px 100px 25px;
                
                @top-center { content: element(header); }
                @bottom-center { content: element(footer); }
                
                }
                
                /* ===== GLOBAL ===== */
                html,
                body,
                table,
                tr,
                td,
                th,
                div,
                span,
                p,
                b,
                strong,
                label,
                li,
                ul,
                ol,
                h1,
                h2,
                h3,
                h4,
                h5,
                h6,
                thead,
                tbody,
                tfoot {
                font-family: Arial, Helvetica, sans-serif !important;
                /* font-family: 'NotoSansFont', Arial , sans-serif ; */
                }
                /* force every bold element to the dedicated bold family */
            /* b, strong, .group-cell-title, .group-cell-sn, .sub-title,
            .grand-total-row td, .q-label, .summary-label, .summary-value,
            .terms-title, .label {
                font-family: 'NotoSansFontBold', Arial Unicode MS, sans-serif !important;
                font-weight: normal !important; 
            } */
             .description-text {
            font-family: 'NotoSansFont', Arial Unicode MS , sans-serif;
            }
                    
                body{
                font-size:11pt;
                color:#333;
                }
                
                /* ===== HEADER ===== */
                .header {
                position: running(header);
                text-align: center;
                border-bottom: 2px solid #0072b4;
                padding-bottom: 8px;
                }
                
                .logo { height: 55px; }
                
                .header-title {
                font-size: 15pt;
                font-weight: bold;
                color: #1da56f;
                
                }
                
                
              /* ===== FOOTER ===== */
                .footer {
                position: running(footer);
                }
                .footer-line {
                display: block;
                margin-bottom: 4px;
                line-height: 2;
                vertical-align: middle;
                }
                
               .footer-icon {
                width: 14px;
                height: 14px;
                vertical-align: middle;
                margin-right: 5px;
                margin-bottom: 0px;
                position: relative;
                top: 4px;
                }
                .footer-icon-Website{
                width: 20px;
                height: 20px;
                vertical-align: middle;
                margin-right: 5px;
                margin-bottom: 0px;
                position: relative;
                top: 4px;
                }
                .footer-page-num::before {
                content: "Page " counter(page) " of " counter(pages);
                font-size: 8pt;
                color: #555;
                }
                                
                /* ===== TOP SECTION ===== */
                .top-section { margin-top: 8pt; }
                .left-block { float: left; width: 55%; }
                .right-block { float: right; width: 40%; text-align:right; }
                .clear { clear: both; }
                
                /* ===== TEXT ===== */
                .text-block {
                margin-top: 8pt;
                font-size: 11pt;
                line-height: 1.5;
                }
                
                /* ===== TABLE ===== */
                .items {
                width: 100%;
                border-collapse: collapse;
                margin-top: 8pt;
                margin-bottom: 8pt;
                border: 1px solid #000; /* outer border */
                table-layout: fixed;
                }
                
                /* HEADER */
                .items th {
                background: #0072b4;
                color: white;
                padding: 6pt 8pt;
                font-size: 10pt;
                border: 1px solid #000; 
                white-space: normal;
                word-break: break-word;
                }
                
                
                /* ALL CELLS */
                .items td {
                padding: 6pt 8pt;
                font-size: 10pt;
                border: 1px solid #000; /*  FULL GRID */
                vertical-align: top;
                }
                /* COLUMN WIDTH FIX */
                .items th:nth-child(1),
                .items td:nth-child(1) {
                width: 8%;
                text-align: center;
                }
                
                .items th:nth-child(2),
                .items td:nth-child(2) {
                width: 52%;
                }
                
                .items th:nth-child(3),
                .items td:nth-child(3) {
                width: 10%;
                text-align: center;
                }
                
                .items th:nth-child(4),
                .items td:nth-child(4) {
                width: 12%;
                text-align: right;
                }
                
                .items th:nth-child(5),
                .items td:nth-child(5) {
                width: 8%;
                text-align: center;
                }
                
                .items th:nth-child(6),
                .items td:nth-child(6) {
                width: 10%;
                text-align: right;
                }
                /* ===== MAIN PRODUCT ===== */
                .group-row {
                background: transparent;
                }
                
                .group-row td{
                border: 1px solid #000;
                background: #fff;
                padding: 8pt;
                }
                .sub-product {
                padding-left: 10px;
                line-height: 1.5;
                }
                .group-cell {
                font-weight: bold;
                /* color: #046997; */
                font-size: 11.5pt;
                padding: 10pt;
                /* border-left: 4px solid #046997; */
                }
                
                /* ===== SUB PRODUCT ===== */
                .sub-product {
                padding-left: 20px;
                }
                
               .sub-title {
                    font-weight: bold !important;
                    font-size: 10pt !important;
                    color: #333 !important;
                    line-height: 1.4 !important;
                }
                                
                .sub-desc {
                color: #444;
                font-size: 8.5pt;
                line-height: 1.25;
                font-family: Arial, Helvetica ,'NotoSansUnicode', sans-serif !important;
                }
                .sub-desc p,
                .sub-desc div {
                margin: 0 !important;      /* remove extra spacing */
                padding: 0 !important;
                }
                
                .sub-desc br {
                line-height: 1.3;          /* control spacing */
                }
                
                .right { text-align: right; }
                .center { text-align: center; }
                
                .last-page {
                /* page-break-before: always;*/
                /* page-break-inside: avoid;*/
                font-size: 9pt; /*reduced */
                margin-top: 12pt;
                }
                .items {
                page-break-inside: auto;
                }
                
                .items tr {
                page-break-inside: auto;
                page-break-after: auto;
                }
                
                .items td {
                page-break-inside: auto;
                }
                
                /* .items .summary-label {
                text-align: right;
                font-weight: bold;
                background: #fff;
                }
                
                .items .summary-value {
                text-align: right;
                font-weight: bold;
                background: #fff;
                }
                
                .items .grand-summary-label,
                .items .grand-summary-value {
                background: #046997;
                color: #fff;
                font-weight: bold;
                font-size: 11pt;
                }
                
                .items .grand-summary-label {
                text-align: right;
                }
                
                .items .grand-summary-value {
                text-align: right;
                } */
                .summary-row td {
                padding: 10pt 12pt;
                border: 1px solid #000;
                vertical-align: middle;
                font-size: 10pt;
                }
                
                .summary-label {
                text-align: right;
                font-weight: bold;
                background: #fff;
                white-space: nowrap;
                }
                
                .summary-value {
                text-align: right;
                font-weight: bold;
                background: #fff;
                width: 140px;
                white-space: nowrap;
                }
                
                .grand-total-row td {
                background: #0072b4;
                color: #fff;
                font-weight: bold;
                font-size: 12pt;
                padding: 12pt;
                vertical-align: middle;
                white-space: nowrap;
                
                border-top: 1px solid #000;
                border-bottom: 1px solid #000;
                }
                
                /* REMOVE INNER VERTICAL LINES */
                .grand-total-row td:first-child {
                border-left: 1px solid #000;
                border-right: none !important;
                }
                
                .grand-summary-label {
                border-left: none !important;
                border-right: none !important;
                }
                
                .grand-summary-value {
                border-left: none !important;
                border-right: 1px solid #000;
                }
                .grand-summary-label {
                text-align: right;
                padding-right: 18pt !important;
                }
                
                .grand-summary-value {
                text-align: right;
                width: 170px;
                min-width: 170px;
                white-space: nowrap;
                }
                
                /* Prevent breaking inside table */
                .terms-table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid #000;
                font-size: 9pt;
                }
                
                .terms-table tr {
                page-break-inside: avoid;
                }
                
                .terms-table td {
                border: 1px solid #000;
                padding: 6pt;
                vertical-align: top;
                }
                
                /* Left labels */
                .label {
                width: 28%;
                font-weight: bold;
                background: #f2f2f2;
                }
                
                /* Section blocks */
                .section {
                padding: 8pt;
                line-height: 1.4; /* tighter */
                }
                
                .section {
                padding: 10pt;
                line-height: 1.6;
                }
                .center{
                text-align: center;
                }
                /* WATERMARK */
                
                .watermark {
                position: fixed;
                top: 35%;           
                left: 15%;
                right: 10%;
                transform: translate(-50%, -50%);
                opacity: 0.05;     
                z-index: 0;            
                }
                
                /* size control */
                .watermark img {
                width: 520px;        
                }
                
                
                .signature-block {
                margin-top: 30pt;
                font-size: 10pt;
                line-height: 1.6;
                
                page-break-inside: avoid;   /* 🔥 prevents cutting */
                }
                
                .signature-block p {
                margin: 0;
                }
                .group-row td{
                border: 1px solid #000;
                /* background: #e9f2fb; */
                padding: 8pt;
                }
                
                .group-cell-sn{
                font-weight: bold;
                text-align: center;
                width: 8%;
                }
                
                .group-cell-title{
                    font-weight: bold !important;
                    font-size: 11pt !important;
                    color: #333 !important;
                    line-height: 1.4 !important;
                }
                .quote-info{
                width: 100%;
                border-collapse: collapse;
                }
                
                .quote-info td{
                padding: 2px 0;
                font-size: 10pt;
                vertical-align: top;
                }
                
                .q-label{
                width: 80px;
                font-weight: bold;
                text-align: left;
                white-space: nowrap;
                }
                
                .q-colon{
                width: 6px;
                padding: 2px 2px;
                text-align: center;
                font-weight: bold;
                }
                
                .q-value{
                text-align: left;
                padding-left: 6px;
                }
                .q-label,
                .left-label,
                .terms-title {
                color: #0072b4 !important;
                font-weight: bold;
                }
                .centercontent th {
                text-align: center !important;
                }
           
            </style>
        </head>
        
        <body>
            <div class="watermark">
                <img src="{!URLFOR($Resource.pdflogo)}"/>
            </div>
            <!-- FOOTER -->
          

<!-- FOOTER -->
<!-- FOOTER -->
<div style="position:running(footer); font-family:Arial,Helvetica,sans-serif;">

    <!-- Content part - with margin -->
                <div style="text-align:center; font-size:9pt; padding-top:6px; border-top:2px solid #0072b4; margin-left:0px; margin-right:0px; position:relative;">
            
                <!-- Row 1: Address -->
            <div style="display:block; margin-bottom:4px; line-height:1.4;">
            <img src="{!URLFOR($Resource.footer_icon_address)}" class="footer-icon"/>
                    102 Chinmay 1103A 10 Lakaki Road Model Colony Shivajinagar Pune Maharashtra 411016 INDIA
            </div>
            
                <!-- Row 2: Phone | Email | Website -->
            <div style="display:block; margin-bottom:4px; line-height:1.4;">
            <img src="{!URLFOR($Resource.footer_icon_phone)}" class="footer-icon"/>
                    +91 9112455550
            &nbsp; &nbsp;
            <img src="{!URLFOR($Resource.footer_icon_email)}" class="footer-icon"/>
                    Team@MicroSetindia.com &nbsp; &nbsp; Accounts@MicroSetindia.com
            &nbsp; &nbsp;
            <img src="{!URLFOR($Resource.footer_icon_website)}" class="footer-icon-Website"/>
            www.MicroSetindia.com
            </div>
            
                <!-- Page Number: right aligned -->
            <div style="text-align:right; line-height:1.4;">
            <span class="footer-page-num"></span>
            </div>
            
            </div>

    <!-- Color Bar - FULL WIDTH, no margin -->
    <!-- Color Bar - FULL WIDTH -->
        <div style="width:calc(100% + 50px); margin-left:-25px; margin-right:-25px; padding:0; margin-top:4px; margin-bottom:0; font-size:0; line-height:0; overflow:hidden;">
            <div style="width:82%; height:200px; background:#0072b4; float:left;"></div>
            <div style="width:18%; height:200px; background:#1da56f; float:left;"></div>
            <div style="clear:both;"></div>
        </div>
</div>

            
            <!-- HEADER -->
            <div class="header">
                
                <!-- LOGO -->
                <div style="text-align:center;">
                    <img src="{!URLFOR($Resource.Microset_Quotation_Logo)}" class="logo"/>
                </div>
                
               <!-- TITLE -->
            <apex:outputPanel rendered="{!!isOrderPDF}">
                <div class="header-title" style="text-align:center;">
                    TECHNO-COMMERCIAL OFFER
                </div>
            </apex:outputPanel>

            <apex:outputPanel rendered="{!isOrderPDF}">
                <div style="text-align:center; font-size:13pt; font-weight:bold; color:#0072b4;">
                {!quotationNumber}
                </div>
            </apex:outputPanel>
                
            </div>
            
            <div>
                
                <!-- CUSTOMER + QUOTE -->
                <div class="top-section">
                    <div class="left-block">
                        <b>{!customerName}</b><br/>
                        {!customerAddress}<br/>
                        
                        <apex:outputPanel rendered="{!NOT(ISBLANK(mobileNumber))}">
                            <span class="left-label">M :</span> {!mobileNumber}<br/>
                        </apex:outputPanel>
                        
                        <apex:outputPanel rendered="{!NOT(ISBLANK(customerEmail))}">
                            <span class="left-label">E :</span> {!customerEmail}<br/>
                        </apex:outputPanel>
                        
                       <apex:outputPanel rendered="{!NOT(ISBLANK(contactPerson))}">
                            <span class="left-label">Kind Attn :</span> 
                            {!contactSalutation} {!contactPerson}<br/>
                        </apex:outputPanel>
                    </div>
                    
                    <div class="right-block">
                        
                        
                     <!-- QUOTATION PDF - right block -->
                        <apex:outputPanel rendered="{!!isOrderPDF}">
                            <table class="quote-info">
                                <tr>
                                    <td class="q-label">Offer No</td>
                                    <td style="color: #0072b4; font-weight: bold;">:</td>
                                    <td class="q-value">{!quotationNumber}</td>
                                </tr>
                                <tr>
                                    <td class="q-label">Offer Date</td>
                                     <td style="color: #0072b4; font-weight: bold;">:</td>
                                    <td class="q-value">{!quotationDateFormatted}</td>
                                </tr>
                                <tr>
                                    <td class="q-label">Reference</td>
                                     <td style="color: #0072b4; font-weight: bold;">:</td>
                                    <td class="q-value">{!reference}</td>
                                </tr>
                            </table>
                        </apex:outputPanel>

                        <!-- ORDER PDF - right block (sirf Order Start Date + Reference) -->
                     <!-- ORDER PDF - right block -->
                    <apex:outputPanel rendered="{!isOrderPDF}">
                        <table class="quote-info">
                            <tr>
                                <td class="q-label">SO Date</td>
                                 <td style="color: #0072b4; font-weight: bold;">:</td>
                                <td class="q-value">{!quotationDateFormatted}</td>
                            </tr>
                            <tr>
                                <td class="q-label">Offer No</td>
                                 <td style="color: #0072b4; font-weight: bold;">:</td>
                                <td class="q-value">{!offerNumber}</td>
                            </tr>
                            <tr>
                                <td class="q-label">Offer Date</td>
                                <td style="color: #0072b4; font-weight: bold;">:</td>
                                <td class="q-value">{!offerDate}</td>
                            </tr>
                            <tr>
                                <td class="q-label">Reference</td>
                               <td style="color: #0072b4; font-weight: bold;">:</td>
                                <td class="q-value">{!reference}</td>
                            </tr>
                        </table>
                    </apex:outputPanel>
                    </div>
                </div>
                
                <div class="clear"></div>
                
                <!-- INTRO -->
                <div class="text-block">
                    Respected Sir/Madam,<br/><br/>
                    We acknowledge with thanks the receipt of your enquiry and have great pleasure 
                    in submitting our best techno-commercial offer below:
                </div>
                
                <!-- TABLE -->
                <table class="items">
                    
                    <colgroup>
                        <col style="width:5%" />
                        <col style="width:45%" />
                        <col style="width:7%" />
                        <col style="width:15%" />
                        <col style="width:9%" />
                        <col style="width:19%" />
                    </colgroup>
                    
                    <thead>
                        <tr class="centercontent">
                            <th>SN</th>
                            <th>Description</th>
                            <th>Qty Nos</th>
                            <th>Unit Price<br/>{!currencySymbol}</th>
                            <th>Discount</th>
                           <th>Amount<br/>{!currencyCode}</th>
                        </tr>
                    </thead>
                    
                    
                    <tbody>
                        
                        <!-- ===== GROUPED ITEMS ===== -->
                        <apex:repeat value="{!groupedItems}" var="grp">
                            
                            <tr class="group-row">
                                <td class="center group-cell-sn">
                                    {!grp.groupIndex}.
                                </td>
                                
                                <td class="group-cell-title">
                                    {!grp.headerName}
                                </td>
                                <td>&nbsp;</td>
                                <td>&nbsp;</td>
                                <td>&nbsp;</td>
                                <td>&nbsp;</td>
                            </tr>
                            
                            <apex:repeat value="{!grp.lines}" var="li">
                                <tr>
                                    <td class="center">{!li.sequenceLabel}</td>
                                   <td class="sub-product">
                                    <div class="sub-title">{!li.productName}</div>

                                    <apex:outputPanel rendered="{!NOT(ISBLANK(li.modelNumber))}">
                                        <div style="color:#333; font-size:9.5pt;">
                                            Model No: <b></b>{!li.modelNumber}
                                        </div>
                                    </apex:outputPanel>

                                    <div style="color:#046997;">
                                        HSN/SAC: {!li.hsnCode}
                                    </div>

                                    <div class="sub-desc">
                                        <!-- <apex:outputText value="{!li.description}" escape="false"/> -->
                                         <apex:outputText styleClass="description-text" value="{!li.description}" escape="false"/>
                                    </div>
                                        <!-- =========================================
                                        MULTIPLE IMAGES
                                        ========================================= -->
                                        
                                        <apex:outputPanel rendered="{!NOT(ISNULL(li.imageUrls))}">
                                            
                                            <div class="images-container">
                                                
                                                <apex:repeat value="{!li.imageUrls}" var="imgUrl">
                                                    
                                                    <div class="line-image-box">
                                                        
                                                        <img src="{!imgUrl}"
                                                             class="line-image"/>
                                                        
                                                    </div>
                                                    
                                                </apex:repeat>
                                                
                                            </div>
                                            
                                        </apex:outputPanel>
                                    </td>
                                    <td class="center">
                                        <div>{!li.quantity}</div>
                                        <div style="font-size:9pt;">{!li.unit}</div>
                                    </td>
                                    <td class="center"> {!li.unitPriceFmt}</td>
                                    <td class="center">
                                    <apex:outputPanel rendered="{!li.hasDiscount}">
                                        {!li.discount}%
                                    </apex:outputPanel>
                                </td>
                                    <td class="center"><b>{!li.itemTotalFmt}</b></td>
                                </tr>
                            </apex:repeat>
                            
                        </apex:repeat>
                        
                        <!-- ✅ ADD HERE (IMPORTANT) -->
                        <!-- ===== STANDALONE ITEMS ===== -->
                        <apex:repeat value="{!ungroupedItems}" var="li">
                            
                            <tr>
                                <td class="center">{!li.sequenceLabel}</td>
                                
                                <td class="sub-product">
                                    <div class="sub-title">
                                        {!li.productName}
                                    </div>

                                    <apex:outputPanel rendered="{!NOT(ISBLANK(li.modelNumber))}">
                                        <div style="color:#333; font-size:9.5pt;">
                                            Model No: {!li.modelNumber}
                                        </div>
                                    </apex:outputPanel>

                                    <div style="color:#046997;">
                                        HSN/SAC: {!li.hsnCode}
                                    </div>

                                    <div class="sub-desc">
                                        <apex:outputText value="{!li.description}" escape="false"/>
                                    </div>
                                                                    
                                    <!-- =========================================
                                        MULTIPLE IMAGES FOR STANDALONE ITEMS
                                        ========================================= -->
                                    
                                    <apex:outputPanel rendered="{!NOT(ISNULL(li.imageUrls))}">
                                        
                                        <div class="images-container">
                                            
                                            <apex:repeat value="{!li.imageUrls}" var="imgUrl">
                                                
                                                <div class="line-image-box">
                                                    
                                                    <img src="{!imgUrl}"
                                                         class="line-image"/>
                                                    
                                                </div>
                                                
                                            </apex:repeat>
                                            
                                        </div>
                                    </apex:outputPanel>
                                    
                                </td>
                                
                                <td class="center">
                                    <div>{!li.quantity}</div>
                                    <div style="font-size:9pt;"  >{!li.unit}</div>
                                </td>
                                
                                <td class="center">₹ {!li.unitPriceFmt}</td>
                                
                               <td class="center">
                                    <apex:outputPanel rendered="{!li.hasDiscount}">
                                        {!li.discount}%
                                    </apex:outputPanel>
                                </td>
                                
                                <td class="center">
                                    <b> {!li.itemTotalFmt}</b>
                                </td>
                            </tr>
                            
                        </apex:repeat>
                        
                        <tr class="summary-row">
                            <td colspan="5" class="summary-label">
                                Sub Total
                            </td>
                            
                            <td class="summary-value">
                                {!subtotalFmt}
                            </td>
                        </tr>
                        
                        
                        <tr class="summary-row">
                            <td colspan="5" class="summary-label">
                                P&amp;F ({!pfAmount}%)
                            </td>
                            
                            <td class="summary-value">
                                 {!pfAmtFmt}
                            </td>
                        </tr>
                        
                        <tr class="summary-row">
                            <td colspan="5" class="summary-label">
                                Freight
                            </td>
                            
                            <td class="summary-value">
                                <apex:outputText value="{!freightDisplay}" escape="false"/>
                            </td>
                        </tr>
                        
                        <!-- <tr class="summary-row">
                            <td colspan="5" class="summary-label">
                                GST
                            </td>
                            
                            <td class="summary-value">
                            {!totalGSTFmt}
